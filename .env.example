# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini on Vertex AI, in the project the team deploys to (Agent Runtime uses the same).
# Needs, once: gcloud auth application-default login
#              gcloud auth application-default set-quota-project your-gcp-project-id
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Or Gemini through Google AI Studio, with no Google Cloud project: comment out the
# three lines above (Vertex wins when both are set) and set the key.
# GEMINI_API_KEY=your-api-key-here

# The models are set in config/config.yml (models:). ML_MODEL overrides the team's:
# gemini-… on Vertex AI or AI Studio, or any LiteLLM model, e.g. ollama_chat/gpt-oss:120b-cloud.
# ML_MODEL=gemini-3.8-flash

# Send traces to Cloud Trace (needs GCP credentials). Set true at deploy.
OTEL_TO_CLOUD=false

# Deployed only: keep runs/, registry/ and feature_store/ in this bucket, so a redeploy
# or restart keeps the team's work (app/harness/state_sync.py). Leave it unset locally,
# where the folders are on your disk.
# ML_STATE_BUCKET=your-state-bucket
