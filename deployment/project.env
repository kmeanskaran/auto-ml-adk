# The Google Cloud project this repo deploys to: the one place to change it.
#
# scripts/restart_gcp.sh reads it and writes the rest from it (Terraform's
# vars/env.tfvars, your .env); scripts/nuke_gcp.sh reads it for what to delete.
# Bucket names follow from the ID: <PROJECT_ID>-state (runs, models, features) and
# <PROJECT_ID>-tfstate (Terraform's state).
#
# After a nuke the old ID can never be used again: put a new one here, then run
#   scripts/restart_gcp.sh
PROJECT_ID=ml-team-adk
REGION=us-east1
